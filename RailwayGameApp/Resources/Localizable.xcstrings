          }
        }
      }
    },
    "The service is running. Stop it to change the timetable." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服務運行中。請先停止服務再修改時刻表。"
          }
        }
      }
    },
    "The square is your map, 16 km a side. Move the map to choose where its middle is, then tap Build Here." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
