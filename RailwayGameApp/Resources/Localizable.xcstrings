    "Taiwan’s Yilan, Western Trunk, Pingxi and Shenao Lines, built on their real track over the real ground and running" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "台灣的宜蘭線、縱貫線、平溪線與深澳線，照真實路線與地形蓋好、已經在跑"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "台湾の宜蘭線、縦貫線、平渓線、深澳線を実際の線路と地形どおりに建設し、運行中"
          }
        }
      }
    },
    "Take the line's trains off it to reverse its stops." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這條路線有列車時不能反轉站序，請先把列車從路線移除。"
          }
        },
        "ja" : {
          "stringUnit" : {
