    "Line Colours" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路線顏色"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路線色"
          }
        }
      }
    },
    "Lines use colours that are easier to tell apart, and every line badge shows its code." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路線改用更容易分辨的顏色，徽章上加上線號。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路線を見分けやすい色にし、すべての路線記号にコードを表示します。"
          }
        }
      }
    },
    "Weather Effects" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天氣效果"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天気効果"
          }
        }
      }
    },
    "Frame Rate" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "幀數"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フレームレート"
          }
        }
      }
    },
    "Real Trains" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "真實列車"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実在の列車"
          }
        }
      }
    },
    "Day and night: the map gets dark at night, and stations, trains and windows light up. Weather effects: rain and lightning on rainy and stormy days, and a typhoon sign at the stations a typhoon hits. Real trains: on a real-world map, the real lines' trains run faintly by their timetables; they carry none of your passengers and never get in your trains' way. Frame rate: the flat map shows how smoothly it draws; tap the number to see what takes the time." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "晝夜變化：入夜後地圖變暗，車站、列車與窗戶亮起燈光。天氣效果：下雨或雷雨的日子地圖上會下雨、閃電，颱風經過的車站會標上颱風符號。真實列車：在實景地圖上，真實路線的列車照時刻表淡淡地跑；它們不載你的乘客，也不擋你的車。幀數：平面地圖顯示畫面有多順；點數字可看時間花在哪裡。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昼と夜：夜になると地図が暗くなり、駅・列車・窓に明かりがともります。天気効果：雨や嵐の日には雨と稲妻が見られ、台風が来た駅には台風マークが付きます。実在の列車：実在の地図では、実在路線の列車が時刻表どおりに薄く表示されて走ります。乗客は運ばず、あなたの列車の邪魔もしません。フレームレート：平面地図で描画のなめらかさを表示します。数字をタップすると処理時間の内訳を表示します。"
          }
        }
      }
    },
    "Festive Decorations" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "節慶裝飾"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "季節の飾り"
          }
        }
      }
    }
  },
  "version" : "1.0"
