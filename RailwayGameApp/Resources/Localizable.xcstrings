    },
    "Building mode" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建物模式"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建物モード"
          }
        }
      }
    },
    "Tap one of your buildings to demolish it. A managed company pays a tenth of what it cost." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點選自己的建物即可拆除。經營模式下要付建造成本的一成。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の建物をタップして解体します。経営モードでは建設費の1割がかかります。"
          }
        }
      }
    },
    "Map" : {
      "localizations" : {
