    },
    "Trains go on from the last stop back to the first: half in the order of the stops, half the other way. They run in pairs." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列車從最後一站接著開回第一站：一半依站序、一半反方向，以兩列為一組。"
          }
        }
      }
    },
    "Trips a day by station" : {
