    },
    "Operating" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "營運"
          }
        }
      }
    },
    "Passengers pay as they board. Running and upkeep are settled every hour, energy and staff every day, and the balance may go below zero." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "乘客上車時付費。營運與維護每小時結算，能源與員工每日結算，餘額可能變成負數。"
          }
        }
      }
    },
