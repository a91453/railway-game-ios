    "Travel Demand" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出行需求"
          }
        }
      }
    },
    "Demand Change" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需求變化"
          }
        }
      }
    },
    "Population and Travel Data" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人口與出行數據"
          }
        }
      }
    },
    "Population: WorldPop 1 km estimates on real-world maps (0 to 10,000+ people a cell), the towns' 64 m cells on blank maps (people per square km). Travel demand: the trips starting in each 1 km square in each hour, from the stations' demand. Demand change: how they rise or fall from the hour before." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人口：實景地圖上的 WorldPop 約 1km 人口格網（每格 0 至 10,000+ 人），空白地圖上城鎮的 64 m 土地格（每平方公里人數）。出行需求：依車站需求推算每小時從各 1km 方格出發的出行量。需求變化：與前一小時相比的增減。"
          }
        }
      }
    },
    "Population Density Heatmap" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人口密度熱力圖"
          }
        }
      }
    },
    "Population density grid overlay will be available in Phase 2." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人口密度網格圖層將於後續版本推出。"
          }
        }
      }
    },
    "Station Names" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "站名"
          }
        }
      }
    },
    "Station Overlays" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "車站圖層"
          }
        }
      }
    },
    "Station catchment area shows the 800-metre walking reference area (~10 minutes walk)." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示以車站為中心、步行約 10 分鐘的 800 公尺步行服務範圍。"
