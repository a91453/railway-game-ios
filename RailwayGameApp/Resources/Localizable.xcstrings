    "Charge by distance (standard steps)" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "改收階梯票價（標準區段）"
          }
        }
      }
    },
    "Choose Track, Station, Remove or Network to build. Selecting only inspects." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇「軌道」、「車站」、「拆除」或「路網」來建設。「選取」只會檢視。"
          }
        }
      }
    },
    "Choose a station" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇車站"
          }
        }
      }
    },
    "Choose what kind of place the station serves. A station without ridership starts no trips and draws none." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇車站服務的地區類型。沒有客流的車站不會產生旅次，也不會吸引旅次。"
          }
        }
      }
    },
    "Chooses a plain piece, a turnout and the exit that joins the others, or a level crossing." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇一般軌道、道岔與連接其他出口的共用端，或平面交叉。"
          }
        }
      }
    },
    "Chooses how fast game time runs." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇遊戲時間的倍速。"
          }
        }
      }
    },
    "Chooses how it accelerates, brakes and how fast it may run." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇加速、減速與最高速度。"
          }
        }
      }
    },
    "Chooses the train to control." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇要操作的列車。"
          }
        }
      }
    },
    "Clear" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
