    },
    "Tap the map to choose a site. A city building in the way is bought out." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點地圖選位置；擋到的城市建物會被收購拆除。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図をタップして場所を選びます。邪魔になる都市の建物は買収されます。"
          }
        }
      }
    },
    "Build" : {
      "localizations" : {
