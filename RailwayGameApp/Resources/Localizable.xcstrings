    "Terrain" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地形"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地形"
          }
        }
      }
    },
    "The ground's height on real-world maps; hatching marks slopes steeper than 30%, where the city cannot build. Tap a cell for its height. Blank maps are flat." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "實景地圖的地面高度；斜線是超過 30% 的陡坡，城市不能開發。點一格看海拔。空白地圖是平地。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実在の地図の地面の標高です。斜線は30%を超える急斜面で、都市は開発できません。マスをタップすると標高を表示します。白紙の地図は平地です。"
          }
        }
      }
    },
    "Catchment Coverage" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腹地涵蓋"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "駅勢圏のカバー"
          }
        }
      }
    },
    "City" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城市"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "都市"
          }
        }
      }
    },
    "Land use: homes, shops or offices, darker for taller buildings. Land value: NT$ a square metre, higher near good train service; tap a cell for its parts. Catchment coverage: the land within 800 m of a station, and the people no station reaches." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "土地用途：住宅、商業或辦公，建物越高顏色越深。地價：每平方公尺多少 NT$，車站服務越好越高；點一格可看分項。腹地涵蓋：車站 800 公尺內的範圍，以及沒有車站涵蓋的住戶。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "土地利用：住宅・商業・オフィス、高い建物ほど濃い色。地価：1平方メートルあたりのNT$、列車の便が良いほど高く、マスをタップすると内訳を表示。駅勢圏のカバー：駅から800 m以内の範囲と、どの駅も届かない住民。"
          }
        }
      }
    },
