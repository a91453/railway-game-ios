    "Each car is 16 m long. A train of several cars needs track behind it, and platforms as long as it." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每節車廂長 16 公尺。多節的列車後方要有軌道，月台也要和列車一樣長。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1両は16 mです。複数両の列車には後方に線路が必要で、ホームも列車と同じ長さが必要です。"
          }
        }
      }
    },
    "Ease the grade" : {
