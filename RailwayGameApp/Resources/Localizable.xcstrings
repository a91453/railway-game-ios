      }
    },
    "This train runs for a line, which writes its timetables. Take it off the line to give it its own." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這列車為路線服務，時刻表由路線產生。移出路線後才能自訂時刻表。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この列車は路線用で、時刻表は路線が作ります。独自の時刻表にするには路線から外してください。"
          }
        }
      }
    },
    "Three lines already running, in a city that grows" : {
