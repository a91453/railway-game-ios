            "value" : "新路線"
          }
        }
      }
    },
    "New station" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新車站"
          }
        }
      }
    },
    "No line links it to another station with ridership yet: the bars show how its own trips would spread over the day." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還沒有路線連到其他有客流的車站：長條顯示它自己的旅次在一天中的分布。"
          }
        }
      }
    },
    "No lines yet. Pick stations under New Line to create one." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還沒有路線。在「新路線」選擇車站來建立。"
          }
        }
      }
    },
    "No rows yet." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暫無經濟流水。"
          }
        }
      }
    },
    "No stations yet. Choose Station, select an empty tile and build one." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還沒有車站。選擇「車站」，再選一格空地來建造。"
          }
        }
      }
    },
    "No tile selected" : {
      "localizations" : {
