<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Decision 776: the downloader extension of the map packs (Background
  Assets). The rest of the Info.plist is generated (project.yml,
  GENERATE_INFOPLIST_FILE) and merged with this file.
-->
<plist version="1.0">
<dict>
	<key>EXAppExtensionAttributes</key>
	<dict>
		<key>EXExtensionPointIdentifier</key>
		<string>com.apple.background-asset-downloader-extension</string>
	</dict>
</dict>
</plist>
