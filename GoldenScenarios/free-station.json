{
  "schemaVersion": 27,
  "description": "Stations at a point (Stage F1). Grid track runs from (2,1) to (3,1). Central is built at the point (2600, 1100) and Annex at (2100, 1500): both over the grid track's tile (2,1), which neither takes, so the land, the track and the tile station rules are unchanged (a tile station is still refused there) and grid track beside the tile is no platform of theirs. A station at a point needs a name and a point on the map (else the tile under the point, rounding down, is out of bounds), costs a station, and cannot grow onto tiles. On the track network, edge 1 runs straight from (1024, 3072) to (7168, 3072), 6144 long, six tiles of track; Central has a platform from 1024 to 3072 on it and Annex one from 4096 to 5120. A path from the start of edge 1 to Annex ends at the far end of its platform, 5120. A train placed at Central's berth (3072 forward) with a path ending where it stands is stopped at Central.",
  "initialState": {
    "mapWidth": 8,
    "mapHeight": 4,
    "balance": 10000,
    "costs": { "track": 100, "station": 1000, "train": 5000 },
    "gameMinutes": 0,
    "speed": "paused"
  },
  "steps": [
    { "command": { "type": "buildTrack", "x": 2, "y": 1, "connections": ["east", "west"] }, "expect": { "result": "ok" } },
    { "command": { "type": "buildTrack", "x": 3, "y": 1, "connections": ["east", "west"] }, "expect": { "result": "ok" } },
    { "command": { "type": "buildStationAt", "name": "Central", "point": { "x": 2600, "y": 1100 } }, "expect": { "result": "ok" } },
    { "command": { "type": "buildStationAt", "name": "Annex", "point": { "x": 2100, "y": 1500 } }, "expect": { "result": "ok" } },
    { "command": { "type": "buildStationAt", "name": " ", "point": { "x": 0, "y": 0 } }, "expect": { "result": "invalidName" } },
    { "command": { "type": "buildStationAt", "name": "East", "point": { "x": 8192, "y": 0 } }, "expect": { "result": "outOfBounds", "x": 8, "y": 0 } },
    { "command": { "type": "buildStationAt", "name": "West", "point": { "x": -1, "y": 4095 } }, "expect": { "result": "outOfBounds", "x": -1, "y": 3 } },
    { "command": { "type": "buildStation", "name": "Tile", "x": 2, "y": 1 }, "expect": { "result": "tileOccupied", "x": 2, "y": 1 } },
    { "observe": { "type": "platforms", "station": 1 }, "expect": { "platforms": [] } },
    { "command": { "type": "extendStation", "station": 1, "x": 2, "y": 2 }, "expect": { "result": "invalidStationTile", "x": 2, "y": 2 } },
    { "command": { "type": "buildTrackNode", "x": 1024, "y": 3072, "z": 0 }, "expect": { "result": "ok" } },
    { "command": { "type": "buildTrackNode", "x": 7168, "y": 3072, "z": 0 }, "expect": { "result": "ok" } },
    { "command": { "type": "buildTrackEdge", "from": 1, "to": 2, "curve": { "type": "straight" } }, "expect": { "result": "ok" } },
    { "command": { "type": "addTrackPlatform", "station": 1, "edge": 1, "start": 1024, "end": 3072 }, "expect": { "result": "ok" } },
    { "command": { "type": "addTrackPlatform", "station": 2, "edge": 1, "start": 4096, "end": 5120 }, "expect": { "result": "ok" } },
    { "observe": { "type": "pathToStation", "from": { "type": "edge", "edge": 1, "direction": "forward", "offset": 0 }, "station": 2 }, "expect": { "found": true, "trainPath": { "traversals": [], "end": 5120, "distance": 5120 } } },
    { "command": { "type": "purchaseTrain", "name": "T1" }, "expect": { "result": "ok" } },
    { "command": { "type": "placeTrain", "train": 1, "position": { "type": "edge", "edge": 1, "direction": "forward", "offset": 3072 } }, "expect": { "result": "ok" } },
    { "command": { "type": "setTrainPath", "train": 1, "path": [], "end": 3072 }, "expect": { "result": "ok" } },
    { "observe": { "type": "stationStops", "train": 1 }, "expect": { "stations": [1] } }
  ],
  "expectedFinalState": {
    "gameMinutes": 0,
    "speed": "paused",
    "balance": 2200,
    "stations": [
