      { "id": 2, "name": "Local 2", "position": { "type": "node", "x": 2, "y": 4, "heading": "north" }, "movement": { "rate": 1024, "continuation": [], "cursor": 0 }, "timetable": [], "execution": { "type": "inactive" } }
    ]
