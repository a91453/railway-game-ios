{
  "schemaVersion": 9,
  "description": "Route finding on a line a(1,3)-b-c(3,3)-d(4,3) with a loop c-f(3,2)-e(4,2)-d, a separate square S(1,5)-N(1,4)-D(2,4)-E(2,5), an isolated track (6,5) and a station east of d. A route is the fewest links from the node ahead of the train (its node, or the end of its link) to a track tile, never turning straight back; among equally short routes the one whose exit directions come first in north, east, south, west order. Checks: a direct route, the 7-link loop route to a tile behind the train, no route when facing a dead end, routes from a link, the empty route when the node ahead is the destination, no route to a station, empty, off-map or unreachable tile or from an invalid start, the north-first tie-break and the heading ruling it out; then trains follow the routes as continuations, and a train reversed at a dead end gets a route again.",
  "initialState": {
    "mapWidth": 8,
    "mapHeight": 7,
    "balance": 500000,
    "costs": { "track": 1000, "station": 50000, "train": 200000 },
    "gameMinutes": 0,
    "speed": "paused"
  },
  "steps": [
    {
      "command": { "type": "buildTrack", "x": 1, "y": 3, "connections": ["east"] },
      "expect": { "result": "ok" }
    },
    {
      "command": { "type": "buildTrack", "x": 2, "y": 3, "connections": ["east", "west"] },
      "expect": { "result": "ok" }
    },
    {
      "command": { "type": "buildTrack", "x": 3, "y": 3, "connections": ["north", "east", "west"] },
      "expect": { "result": "ok" }
    },
    {
      "command": { "type": "buildTrack", "x": 4, "y": 3, "connections": ["north", "west"] },
      "expect": { "result": "ok" }
    },
    {
      "command": { "type": "buildTrack", "x": 3, "y": 2, "connections": ["east", "south"] },
      "expect": { "result": "ok" }
    },
    {
      "command": { "type": "buildTrack", "x": 4, "y": 2, "connections": ["south", "west"] },
      "expect": { "result": "ok" }
    },
    {
      "command": { "type": "buildTrack", "x": 1, "y": 5, "connections": ["north", "east"] },
      "expect": { "result": "ok" }
    },
    {
      "command": { "type": "buildTrack", "x": 1, "y": 4, "connections": ["east", "south"] },
      "expect": { "result": "ok" }
    },
    {
      "command": { "type": "buildTrack", "x": 2, "y": 5, "connections": ["north", "west"] },
      "expect": { "result": "ok" }
    },
    {
      "command": { "type": "buildTrack", "x": 2, "y": 4, "connections": ["south", "west"] },
      "expect": { "result": "ok" }
    },
    {
      "command": { "type": "buildTrack", "x": 6, "y": 5, "connections": ["north"] },
      "expect": { "result": "ok" }
    },
    {
      "command": { "type": "buildStation", "name": "Yard", "x": 5, "y": 3 },
      "expect": { "result": "ok" }
    },
    {
      "command": { "type": "purchaseTrain", "name": "Local 1" },
      "expect": { "result": "ok" }
    },
    {
      "command": { "type": "purchaseTrain", "name": "Local 2" },
      "expect": { "result": "ok" }
    },
    {
      "observe": { "type": "route", "from": { "type": "node", "x": 2, "y": 3, "heading": "east" }, "to": { "x": 4, "y": 3 } },
      "expect": { "found": true, "route": [{ "x": 3, "y": 3 }, { "x": 4, "y": 3 }] }
    },
    {
      "observe": { "type": "route", "from": { "type": "node", "x": 2, "y": 3, "heading": "east" }, "to": { "x": 1, "y": 3 } },
      "expect": { "found": true, "route": [{ "x": 3, "y": 3 }, { "x": 3, "y": 2 }, { "x": 4, "y": 2 }, { "x": 4, "y": 3 }, { "x": 3, "y": 3 }, { "x": 2, "y": 3 }, { "x": 1, "y": 3 }] }
    },
    {
      "observe": { "type": "route", "from": { "type": "node", "x": 2, "y": 3, "heading": "west" }, "to": { "x": 4, "y": 3 } },
      "expect": { "found": false }
    },
    {
      "observe": { "type": "route", "from": { "type": "link", "from": { "x": 1, "y": 3 }, "to": { "x": 2, "y": 3 }, "offset": 700 }, "to": { "x": 3, "y": 3 } },
      "expect": { "found": true, "route": [{ "x": 3, "y": 3 }] }
    },
    {
      "observe": { "type": "route", "from": { "type": "link", "from": { "x": 1, "y": 3 }, "to": { "x": 2, "y": 3 }, "offset": 700 }, "to": { "x": 2, "y": 3 } },
      "expect": { "found": true, "route": [] }
    },
    {
      "observe": { "type": "route", "from": { "type": "node", "x": 2, "y": 3, "heading": "east" }, "to": { "x": 5, "y": 3 } },
      "expect": { "found": false }
    },
    {
      "observe": { "type": "route", "from": { "type": "node", "x": 2, "y": 3, "heading": "east" }, "to": { "x": 0, "y": 0 } },
      "expect": { "found": false }
    },
    {
      "observe": { "type": "route", "from": { "type": "node", "x": 2, "y": 3, "heading": "east" }, "to": { "x": 8, "y": 3 } },
      "expect": { "found": false }
    },
    {
      "observe": { "type": "route", "from": { "type": "node", "x": 2, "y": 3, "heading": "east" }, "to": { "x": 6, "y": 5 } },
      "expect": { "found": false }
    },
    {
      "observe": { "type": "route", "from": { "type": "link", "from": { "x": 1, "y": 3 }, "to": { "x": 2, "y": 3 }, "offset": 0 }, "to": { "x": 3, "y": 3 } },
      "expect": { "found": false }
    },
    {
      "observe": { "type": "route", "from": { "type": "node", "x": 0, "y": 0, "heading": "east" }, "to": { "x": 3, "y": 3 } },
      "expect": { "found": false }
    },
    {
      "observe": { "type": "route", "from": { "type": "node", "x": 1, "y": 5, "heading": "east" }, "to": { "x": 2, "y": 4 } },
      "expect": { "found": true, "route": [{ "x": 1, "y": 4 }, { "x": 2, "y": 4 }] }
    },
    {
      "observe": { "type": "route", "from": { "type": "node", "x": 1, "y": 5, "heading": "south" }, "to": { "x": 2, "y": 4 } },
      "expect": { "found": true, "route": [{ "x": 2, "y": 5 }, { "x": 2, "y": 4 }] }
    },
    {
      "command": { "type": "placeTrain", "train": 1, "position": { "type": "node", "x": 2, "y": 3, "heading": "east" } },
      "expect": { "result": "ok" }
    },
    {
      "command": { "type": "setTrainContinuation", "train": 1, "continuation": [{ "x": 3, "y": 3 }, { "x": 3, "y": 2 }, { "x": 4, "y": 2 }, { "x": 4, "y": 3 }, { "x": 3, "y": 3 }, { "x": 2, "y": 3 }, { "x": 1, "y": 3 }] },
      "expect": { "result": "ok" }
    },
    {
      "command": { "type": "setTrainMovementRate", "train": 1, "rate": 7168 },
      "expect": { "result": "ok" }
    },
    {
      "command": { "type": "placeTrain", "train": 2, "position": { "type": "node", "x": 1, "y": 5, "heading": "south" } },
      "expect": { "result": "ok" }
    },
    {
      "command": { "type": "setTrainContinuation", "train": 2, "continuation": [{ "x": 2, "y": 5 }, { "x": 2, "y": 4 }] },
      "expect": { "result": "ok" }
    },
    {
      "command": { "type": "setTrainMovementRate", "train": 2, "rate": 1024 },
      "expect": { "result": "ok" }
    },
    {
      "command": { "type": "setSpeed", "speed": "normal" },
      "expect": { "result": "ok" }
    },
    {
      "command": { "type": "advance", "ticks": 1 },
      "expect": { "result": "ok" }
    },
    {
      "observe": { "type": "train", "train": 1 },
      "expect": { "position": { "type": "node", "x": 1, "y": 3, "heading": "west" }, "movement": { "rate": 7168, "continuation": [], "cursor": 0 } }
    },
    {
      "observe": { "type": "train", "train": 2 },
      "expect": { "position": { "type": "node", "x": 2, "y": 5, "heading": "east" }, "movement": { "rate": 1024, "continuation": [{ "x": 2, "y": 5 }, { "x": 2, "y": 4 }], "cursor": 1 } }
    },
    {
      "command": { "type": "advance", "ticks": 1 },
      "expect": { "result": "ok" }
    },
    {
      "observe": { "type": "train", "train": 2 },
      "expect": { "position": { "type": "node", "x": 2, "y": 4, "heading": "north" }, "movement": { "rate": 1024, "continuation": [], "cursor": 0 } }
    },
    {
      "observe": { "type": "route", "from": { "type": "node", "x": 1, "y": 3, "heading": "west" }, "to": { "x": 4, "y": 3 } },
      "expect": { "found": false }
    },
    {
      "command": { "type": "reverseTrain", "train": 1 },
      "expect": { "result": "ok" }
    },
    {
      "observe": { "type": "route", "from": { "type": "node", "x": 1, "y": 3, "heading": "east" }, "to": { "x": 4, "y": 3 } },
      "expect": { "found": true, "route": [{ "x": 2, "y": 3 }, { "x": 3, "y": 3 }, { "x": 4, "y": 3 }] }
    },
    {
      "command": { "type": "setTrainContinuation", "train": 1, "continuation": [{ "x": 2, "y": 3 }, { "x": 3, "y": 3 }, { "x": 4, "y": 3 }] },
      "expect": { "result": "ok" }
    },
    {
      "command": { "type": "advance", "ticks": 1 },
      "expect": { "result": "ok" }
    },
    {
      "observe": { "type": "train", "train": 1 },
      "expect": { "position": { "type": "node", "x": 4, "y": 3, "heading": "east" }, "movement": { "rate": 7168, "continuation": [], "cursor": 0 } }
    }
  ],
