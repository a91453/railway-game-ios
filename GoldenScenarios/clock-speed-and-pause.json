    },
    {
      "command": { "type": "resume" },
      "expect": { "result": "ok" }
    },
    {
      "command": { "type": "advance", "ticks": 10 },
      "expect": { "result": "ok" }
    },
    {
      "command": { "type": "setSpeed", "speed": "paused" },
